<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.PlainUBGui" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        
        <item name="android:windowBackground">@color/bg_dark_gradient_start</item>
        <item name="android:statusBarColor">@color/bg_dark_gradient_start</item>
        <item name="android:navigationBarColor">@color/bg_dark_gradient_end</item>
        
        <!-- Enable Edge-to-Edge styling support -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
